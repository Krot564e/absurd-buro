# Скопируй этот файл в .env и подставь своё значение.
# Сгенерировать: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=замени_на_случайную_строку_минимум_32_символа

# Пароль от /security-log. Без этой переменной журнал отдаёт 404.
LOG_PASSWORD=замени_на_свой_пароль_журнала

PORT=3000
NODE_ENV=development

# На хостинге (HTTPS) обязательно 1, локально по http — 0.
SECURE_COOKIES=0

# Лимиты (сделаны переменными, потому что за одним IP на хостинге сидит много народу)
LIMIT_GLOBAL=300
LIMIT_LOGIN=5
LIMIT_REGISTER=3
LIMIT_POST=10
# После скольких неудачных входов включается капча
CAPTCHA_AFTER=3