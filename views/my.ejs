<%- include('partials/head') %>

<h1>Мои записи</h1>
<p><%= user.username %></p>

<% if (!requests.length) { %>
  <p>Пока ничего нет. <a href="/">Создать</a></p>
<% } else { %>
  <ul>
    <% requests.forEach(function (r) { %>
      <li><a href="/r/<%= r.id %>"><%= r.ticket %></a> — <%= r.title %></li>
    <% }); %>
  </ul>
<% } %>