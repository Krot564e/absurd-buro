<%- include('partials/head') %>

<h1>Мои заявки</h1>
<p class="lede">Личность: <%= user.username %> · с нами с <%= (user.created_at || '').slice(0, 10) %></p>

<% if (!requests.length) { %>
  <div class="doc">
    <p>Пока ни одной заявки.</p>
    <p><a href="/">Подать первую</a></p>
  </div>
<% } else { %>
  <div class="doc">
    <ul class="kv">
      <% requests.forEach(function (r) { %>
        <li>
          <span><a href="/r/<%= r.id %>"><%= r.ticket %></a> — <%= r.title %></span>
          <span class="status"><%= r.status %></span>
        </li>
      <% }); %>
    </ul>
  </div>
<% } %>

<div class="note">
  Все заявки видны в <a href="/feed">общей ленте</a>.
</div>