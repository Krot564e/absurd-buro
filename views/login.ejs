<%- include('partials/head') %>

<h1>Вход</h1>

<% if (error) { %><p><%= error %></p><% } %>

<form method="post" action="/login">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <input type="hidden" name="_ts" value="<%= Date.now() %>">

  <div style="display:none" aria-hidden="true">
    <label>Не заполняй это поле</label>
    <input type="text" name="website" tabindex="-1" autocomplete="off">
  </div>

  <p>
    <label for="login">Email или никнейм</label><br>
    <input type="text" id="login" name="login" required autocomplete="username" value="<%= values.login %>">
  </p>

  <p>
    <label for="password">Пароль</label><br>
    <input type="password" id="password" name="password" required autocomplete="current-password">
  </p>

  <% if (needCaptcha) { %>
    <p>
      <label for="captcha">Пример: <%= captchaQuestion %> = ?</label><br>
      <input type="text" id="captcha" name="captcha" inputmode="numeric" required autocomplete="off">
    </p>
  <% } %>

  <button type="submit">Войти</button>
</form>