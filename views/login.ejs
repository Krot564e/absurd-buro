<%- include('partials/head') %>

<h1>Вход</h1>
<p class="lede">Для тех, кто помнит свой пароль.</p>

<% if (error) { %><div class="alert"><%= error %></div><% } %>

<form method="post" action="/login" class="doc">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <input type="hidden" name="_ts" value="<%= Date.now() %>">

  <div class="honeypot" aria-hidden="true">
    <label>Не заполняй это поле</label>
    <input type="text" name="website" tabindex="-1" autocomplete="off">
  </div>

  <label for="login">EMAIL ИЛИ НИКНЕЙМ</label>
  <input type="text" id="login" name="login" required autocomplete="username" value="<%= values.login %>">

  <label for="password">ПАРОЛЬ</label>
  <input type="password" id="password" name="password" required autocomplete="current-password">

  <% if (needCaptcha) { %>
    <div class="abs-captcha-slot" data-abs-captcha>
      <input type="hidden" id="captcha" name="captcha" value="">
    </div>
  <% } %>

  <button type="submit">Войти</button>
</form>

<div class="note">
  После 5 неудачных попыток с одного адреса вход закрывается на 15 минут.
</div>