<%- include('partials/head') %>

<h1>Лента</h1>

<% if (!requests.length) { %>
  <p>Пока пусто.</p>
<% } else { %>
  <ul>
    <% requests.forEach(function (r) { %>
      <li>
        <a href="/r/<%= r.id %>"><%= r.ticket %></a> — <%= r.title %><br>
        <%= r.justification.slice(0, 90) %><%= r.justification.length > 90 ? '…' : '' %>
      </li>
    <% }); %>
  </ul>
<% } %>