<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %> — MAX+</title>
  <link rel="stylesheet" href="/public/style.css">
  <link rel="icon" href="/public/favicon.ico" type="image/x-icon">
  <script src="/public/absurd.js" defer></script>
  <script src="/public/ad.js" defer></script>
  <script src="/public/captcha.js" defer></script>
</head>
<body data-csrf="<%= csrfToken %>">
  <header class="topbar">
    <a class="brand" href="/"><img src="/public/favicon.ico" alt=""><span>MAX+</span></a>
    <nav>
      <% if (user) { %>
        <a href="/my">Мои заявки</a>
        <form method="post" action="/logout" class="inline">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <button type="submit" class="linklike">Выйти (<%= user.username %>)</button>
        </form>
      <% } else { %>
        <a href="/feed">Заявки</a>
        <a href="/login">Вход</a>
        <a href="/register">Создать личность</a>
      <% } %>
    </nav>
  </header>
  <main>