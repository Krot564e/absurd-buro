<%- include('partials/head') %>

<h1><%= title %></h1>

<% if (error) { %><p><%= error %></p><% } %>

<% if (user) { %>
  <form method="post" action="/requests">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <input type="hidden" name="_ts" value="<%= Date.now() %>">

    <div style="display:none" aria-hidden="true">
      <label>Не заполняй это поле</label>
      <input type="text" name="website" tabindex="-1" autocomplete="off">
    </div>

    <p>
      <label for="category">Категория</label><br>
      <select id="category" name="category">
        <% categories.forEach(function (c) { %>
          <option value="<%= c %>" <%= values.category === c ? 'selected' : '' %>><%= c %></option>
        <% }); %>
      </select>
    </p>

    <p>
      <label for="title">Заголовок (8–140 символов)</label><br>
      <input type="text" id="title" name="title" maxlength="140" required value="<%= values.title %>">
    </p>

    <p>
      <label for="justification">Текст (20–2000 символов)</label><br>
      <textarea id="justification" name="justification" maxlength="2000" required><%= values.justification %></textarea>
    </p>

    <button type="submit">Отправить</button>
  </form>
<% } else { %>
  <p><a href="/login">Войти</a> или <a href="/register">зарегистрироваться</a>.</p>
<% } %>