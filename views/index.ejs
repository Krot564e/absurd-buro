<%- include('partials/head') %>

<h1>MAX+</h1>
<p class="lede">
  Никому не доверяй, даже нам.
</p>

<p class="counter">Приватный мессенджер · Без телефона. Без почты. Без имён. · Версия 0.2.15 · В разработке</p>

<% if (error) { %><div class="alert"><%= error %></div><% } %>

<% if (user) { %>
  <h2>Подать заявку</h2>
  <form method="post" action="/requests" class="doc">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <input type="hidden" name="_ts" value="<%= Date.now() %>">

    <div class="honeypot" aria-hidden="true">
      <label>Не заполняй это поле</label>
      <input type="text" name="website" tabindex="-1" autocomplete="off">
    </div>

    <label for="category">КАТЕГОРИЯ</label>
    <select id="category" name="category">
      <% ['Баг', 'Фича', 'Приватность', 'Оформление', 'Прочее'].forEach(function (c) { %>
        <option value="<%= c %>" <%= values.category === c ? 'selected' : '' %>><%= c %></option>
      <% }); %>
    </select>

    <label for="title">СУТЬ ЗАЯВКИ (8–140 символов)</label>
    <input type="text" id="title" name="title" maxlength="140" required value="<%= values.title %>"
           placeholder="Сделайте так, чтобы сообщения исчезали через 5 секунд">

    <label for="justification">ПОДРОБНОСТИ (20–2000 символов)</label>
    <textarea id="justification" name="justification" maxlength="2000" required
              placeholder="Сообщение должно удаляться сразу после прочтения, а не когда об этом вспомнит сервер."><%= values.justification %></textarea>

    <button type="submit">Подать заявку</button>
  </form>
<% } else { %>
  <h2>Чтобы подать заявку, нужен аккаунт</h2>
  <div class="doc">
    <p>Заявки пишут только созданные личности. Без аккаунта заявка остаётся анонимной, а анонимные мы не рассматриваем.</p>
    <p><a href="/register">Создать личность</a> · <a href="/login">У меня уже есть</a></p>
  </div>
<% } %>

<h2>Примеры заявок, которые нам уже принесли</h2>
<ul class="examples">
  <% examples.forEach(function (ex) { %><li><%= ex %></li><% }); %>
</ul>
