<%- include('partials/head') %>

<h1>Регистрация</h1>

<% if (error) { %><p><%= error %></p><% } %>

<form method="post" action="/register">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <input type="hidden" name="_ts" value="<%= Date.now() %>">

  <div style="display:none" aria-hidden="true">
    <label>Не заполняй это поле</label>
    <input type="text" name="website" tabindex="-1" autocomplete="off">
  </div>

  <p>
    <label for="email">Email</label><br>
    <input type="email" id="email" name="email" required autocomplete="email" value="<%= values.email %>">
  </p>

  <p>
    <label for="username">Никнейм (3–24: латиница, цифры, _)</label><br>
    <input type="text" id="username" name="username" required autocomplete="username" value="<%= values.username %>">
  </p>

  <p>
    <label for="password">Пароль (мин. <%= minLength %>)</label><br>
    <input type="password" id="password" name="password" required autocomplete="new-password">
  </p>

  <% if (needCaptcha) { %>
    <p>
      <label for="captcha">Пример: <%= captchaQuestion %> = ?</label><br>
      <input type="text" id="captcha" name="captcha" inputmode="numeric" required autocomplete="off">
    </p>
  <% } %>

  <button type="submit">Зарегистрироваться</button>
</form>