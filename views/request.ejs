<%- include('partials/head') %>

<h1><%= request.title %></h1>
<p><%= request.ticket %></p>

<ul>
  <li>Категория: <%= request.category %></li>
  <li>Дата: <%= (request.created_at || '').slice(0, 16).replace('T', ' ') %></li>
  <li>Статус: <%= request.status %></li>
</ul>

<p><%= request.justification %></p>